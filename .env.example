# Server only. Copy to .env and fill in your local MongoDB connection.
MONGODB_URI=mongodb://127.0.0.1:27017/orbit
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Set NODE_ENV=production and APP_ORIGIN to your exact HTTPS site URL in hosting.
# Never prefix database secrets with VITE_; VITE_ values are public.
